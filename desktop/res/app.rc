#include <windows.h>

APPICON ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "qiapicoco"
            VALUE "FileDescription",  "MD Image Cleaner"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "MDImageCleaner"
            VALUE "LegalCopyright",   "qiapicoco"
            VALUE "OriginalFilename", "MDImageCleaner.exe"
            VALUE "ProductName",      "MD Image Cleaner"
            VALUE "ProductVersion",   "2.0.0.0"
            VALUE "Comments",         "Markdown 未引用图片清理"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
